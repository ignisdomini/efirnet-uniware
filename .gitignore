# Сборка PlatformIO
.pio/
bootmanager/.pio/

# Готовые образы: они уезжают в релиз GitHub, а не в историю.
# Иначе каждая пересборка добавляет к репозиторию по двадцать мегабайт,
# и клон через год весит больше, чем весь проект.
dist/

# Маркетинг: презентация и макеты для объявлений. Собираются скриптами
# из этой же папки и к прошивке отношения не имеют.
promo/
*.bin
!bootmanager/include/*.h

# Дампы флеша: снимаются перед экспериментами, к коду отношения не имеют.
BACKUP_*.bin

# Локальные временные файлы
*.log
__pycache__/
